{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.codex.musescore-control",
  "Name": "MuseScore Control",
  "Version": "0.2.0.0",
  "Author": "Codex",
  "Description": "Control MuseScore Studio from individually configurable Stream Deck keys.",
  "Icon": "static/imgs/plugin",
  "Category": "MuseScore Control",
  "CategoryIcon": "static/imgs/category",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "ApplicationsToMonitor": {
    "mac": [
      "org.musescore.MuseScore"
    ]
  },
  "Actions": [
    {
      "UUID": "com.codex.musescore-control.command",
      "Name": "操作",
      "Icon": "static/imgs/actions/command",
      "Tooltip": "MuseScoreの操作を選んで実行します。",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/musescore-command.html",
      "States": [
        {
          "Image": "static/imgs/actions/command"
        }
      ]
    },
    {
      "UUID": "com.codex.musescore-control.palette.grace-notes",
      "Name": "装飾音符",
      "Icon": "static/imgs/actions/palette-grace-notes",
      "Tooltip": "装飾音符パレットから選んだ項目を適用します。",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/musescore-palette-category.html",
      "States": [
        {
          "Image": "static/imgs/actions/palette-grace-notes"
        }
      ]
    },
    {
      "UUID": "com.codex.musescore-control.palette.ornaments",
